# Keep the build context small and, more importantly, keep secrets out of it.
# Anything sent to the daemon can end up in a layer.
.env
.git
.venv
__pycache__
*.pyc
*.egg-info

# Installed inside the image; sending 144MB of host node_modules would slow every
# build and risk platform-specific binaries leaking in.
app/web/node_modules
app/web/dist

# Regenerable, and large. .cache is 70MB of embedding cache keyed on content hash
# plus PARSER_VERSION -- the deployed index already contains what it needs, and a
# cache built on the host is not guaranteed to match the image's parser version.
.cache
data/eval/judged_partial.json
experiments/out

.claude
.idea
.vscode
