# Copy to .env and fill in.
#
# Get a free key from https://aistudio.google.com/apikey
# Free tier: rate limits are per-project and only visible in AI Studio
# (https://aistudio.google.com/rate-limit). We do NOT hardcode them —
# ragkit/limits.py detects 429 RESOURCE_EXHAUSTED at runtime and tells you.
GEMINI_API_KEY=

# Optional: force the quota-exhausted code path so you can see the
# degradation notice render without waiting to actually get rate-limited.
# RAGKIT_FAKE_QUOTA_EXHAUSTED=1
